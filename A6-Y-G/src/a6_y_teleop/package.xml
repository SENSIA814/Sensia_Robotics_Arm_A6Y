<?xml version="1.0"?>
<package format="3">
  <name>a6_y_teleop</name>
  <version>0.1.0</version>
  <description>Leader-follower joint teleoperation tools for A6-Y.</description>
  <maintainer email="2470428938@qq.com">a6_y_robot_team</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>A6_Y_Moveitconfig</exec_depend>
  <exec_depend>a6_y_controllers</exec_depend>
  <exec_depend>a6_y_ros2_control</exec_depend>
