# 0: status/heartbeat, 1: execute an already collision-checked path, 2: cancel.
# Cancel restores gravity mode; it never enables an inactive controller.
uint8 command
uint64 revision
float64[] times
# Flattened rows of J1..J6, cubic Hermite knots; no gripper command.
float64[] positions
float64[] velocities
