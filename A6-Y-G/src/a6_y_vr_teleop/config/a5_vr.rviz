Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Virtual A5
      Enabled: true
      Value: true
      Description Source: Topic
      Description Topic:
        Value: /arm6_vr/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      TF Prefix: vr_a5
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Targets and status
      Enabled: true
      Value: true
      Topic:
        Value: /arm6_vr/markers
    - Class: rviz_default_plugins/Axes
      Name: Tool TCP
      Enabled: true
      Value: true
      Reference Frame: vr_a5/tool_tcp
      Length: 0.08
      Radius: 0.005
  Global Options:
    Fixed Frame: vr_a5/base_link
    Frame Rate: 30
    Background Color: 36; 40; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.7
      Focal Point: {X: 0.15, Y: 0.0, Z: 0.35}
      Pitch: 0.45
      Yaw: -0.7
      Target Frame: vr_a5/base_link
Window Geometry:
  Width: 1200
  Height: 900
