Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link
    Background Color: 35; 35; 35
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
    - Class: rviz_default_plugins/RobotModel
      Name: Actual feedback
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /arm6/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      TF Prefix: ""
      Alpha: 1
    - Class: rviz_default_plugins/RobotModel
      Name: VR reference (preview only in readonly)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /arm6/vr/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      TF Prefix: vr_ref
      Alpha: 0.35
    - Class: rviz_default_plugins/MarkerArray
      Name: Actual and target TCP
      Enabled: true
      Topic:
        Value: /arm6/vr/markers
        Reliability Policy: Reliable
        Depth: 10
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Pitch: 0.4
      Yaw: 0.8
      Focal Point: {X: 0.2, Y: 0, Z: 0.3}
Window Geometry:
  Width: 1200
  Height: 850
